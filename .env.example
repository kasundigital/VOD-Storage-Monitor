# Copy to .env and change your password and secret.
TZ=America/New_York
ADMIN_PASSWORD=CHANGE_ME_NOW
SECRET_KEY=CHANGE_TO_A_LONG_RANDOM_SECRET

REFRESH_SECONDS=60
# How often to run `snapraid status` + `snapraid diff` (they read every data disk).
SNAPRAID_CHECK_SECONDS=900
# Highlight "Last sync" when older than this many hours, "Scrub" when newest scrub is older than N days.
SYNC_STALE_HOURS=26
SCRUB_STALE_DAYS=14
SNAPRAID_CONFIG=/etc/snapraid.conf

# Host logfile readable through the /docker read-only bind mount. Globs are allowed
# (e.g. /docker/snapraid/logs/*.log); the newest matching file is used.
SNAPRAID_LOG_PATH=/docker/snapraid-recovery-backup/resync-final.log

# Optional; requires explicitly mounting the Docker socket.
ENABLE_DOCKER_MONITOR=false
